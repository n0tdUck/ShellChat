{
  "manifest_version": 3,
  "name": "CMD Bridge",
  "version": "1.1",
  "description": "A cmd.exe session (native messaging) and WebSocket chat rooms in one tab, with a tab bar to switch between them.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open CMD Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
