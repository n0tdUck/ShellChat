{
  "manifest_version": 3,
  "name": "CMD Bridge",
  "version": "1.2",
  "description": "Runs a cmd.exe session (native messaging) in the background and lets a WebSocket chat room drive it with /cmd.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js", "type": "module"
  },
  "action": {
    "default_title": "CMD Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
